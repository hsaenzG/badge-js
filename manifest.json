{
	"include": [
		"$(MODDABLE)/examples/manifest_base.json",
		"$(MODDABLE)/examples/manifest_commodetto.json",
		"$(MODDABLE)/examples/manifest_typings.json",
		"$(COMMODETTO)/manifest_cfeft.json",
		"$(MODULES)/data/qrcode/manifest.json",
		"$(COMMODETTO)/qrcode/manifest.json",
		"$(IO)/digital",
		"$(MODDABLE)/modules/io/wifi",
		"$(MODDABLE)/modules/io/socket",
		"$(MODDABLE)/modules/io/dns/resolver",
		"$(MODDABLE)/modules/io/ntp/client",
		"$(MODDABLE)/modules/web/fetch",
		"$(MODULES)/files/preference"
	],
	"typescript": {
		"tsconfig": {
			"compilerOptions": {
				"strict": true,
				"noUncheckedIndexedAccess": true
			}
		}
	},
	"modules": {
		"*": "./src/apps/main",
		"core/*": "./src/core/*",
		"core/game/*": "./src/core/game/*",
		"platform/*": "./src/platform/*"
	},
	"data": {
		"*": [
			"./assets/fonts/JetBrainsMonoNL-Regular",
			"./assets/fonts/JetBrainsMonoNL-Bold",
			"$(MODULES)/crypt/data/ca222"
		]
	}
}
