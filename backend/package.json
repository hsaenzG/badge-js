{
  "name": "mictlan-guardian-backend",
  "version": "0.1.0",
  "private": true,
  "description": "El Guardián del Código: Strands Harness on Lambda behind API Gateway (Phase 3)",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "bundle": "node scripts/bundle.mjs",
    "synth": "npm run bundle && cdk synth --strict -q",
    "diff": "npm run bundle && cdk diff",
    "deploy": "npm run bundle && cdk deploy"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1156.0",
    "@aws-sdk/lib-dynamodb": "3.1156.0",
    "@strands-agents/harness": "0.3.1",
    "@strands-agents/sdk": "1.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/aws-lambda": "8.10.164",
    "@types/node": "26.6.5",
    "aws-cdk": "2.1146.1",
    "aws-cdk-lib": "2.274.0",
    "cdk-nag": "3.0.2",
    "constructs": "10.8.1",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
